# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Node, for the Tier 0 bridge and the widgets
node_modules/
*.tsbuildinfo

# Site output, and the lessons and blueprints staged into it. MkDocs can only see what is under
# its docs directory, so `just site` copies them in. The originals are the committed ones.
site/_build/
site/docs/lessons/
site/docs/blueprints/
.cache/

# v86, fetched by tools.vendor and checked against kxbox/web/vendor.toml. Four megabytes of
# somebody else's build, pinned rather than committed.
kxbox/web/vendor/

# Kernel build artefacts. The recipe is in the repo, the output is not.
kxbox/kernel/build/
kxbox/kernel/*.bzImage
kxbox/rootfs/build/
kxbox/rootfs/*.img
*.ko
*.o
*.mod
*.mod.c
.tmp_versions/
Module.symvers
modules.order

# Traces and dumps land here while you work. Anything a lesson depends on goes
# into corpora/ instead, committed, so the build is reproducible.
scratch/
*.trace.raw

# `uv run` writes this, and it pins the resolved versions of the development tools rather than
# anything the project promises. Committing it would freeze CI on whatever a laptop resolved.
uv.lock

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
