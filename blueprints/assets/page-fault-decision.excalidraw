      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "text": "The restart is why a fault is invisible from userspace. The same instruction runs twice and the second one works.",
      "originalText": "The restart is why a fault is invisible from userspace. The same instruction runs twice and the second one works.",
