      "versionNonce": 1321137109,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "text": "fsync is what turns that into a promise about storage, and it is a separate mechanism with its own blueprint.",
