[388.959323, "o", "ls -lh linux\r\n\u001b]133;C\u0007"]
[388.960728, "o", "-rwxr-xr-x 2 root root 84M Sep  5 21:42 linux\r\n"]
[388.961903, "o", "\u001b]133;D;0\u0007\u001b]133;A\u0007$ \u001b]133;B\u0007"]
[388.964382, "o", "cat /root/kxreplay/inside.sh\r\n\u001b]133;C\u0007"]
[388.966555, "o", "#!/bin/sh\r\n# This runs as init inside the kernel that was just built.\r\n#\r\n# There is no root filesystem image anywhere in this session. The kernel was told to mount the\r\n# filesystem it was built on as its own root, read only, which User Mode Linux can do because it\r\n"]
[388.968207, "o", "# is a kernel that runs as an ordinary process. So every program below is a binary from outside\r\n# running under a kernel that is a few minutes old.\r\nmount -t proc none /proc\r\nmount -t sysfs none /sys\r\n\r\necho\r\necho \"the kernel that answered:\"\r\ncat /proc/version\r\n\r\necho\r\necho \"processors it can see:\"\r\ngrep -c '^processor' /proc/cpuinfo\r\n\r\necho\r\necho \"how long it has been alive, in seconds:\"\r\ncat /proc/uptime\r\n\r\necho\r\necho \"the first few things it said while booting:\"\r\ndmesg | head -6\r\n\r\necho\r\necho \"is ftrace in this build?\"\r\nif mount -t tracefs none /sys/kernel/tracing 2>/dev/null; then\r\n    ls /sys/kernel/tracing | head -5\r\nelse\r\n    echo \"no, and that is the honest answer for a defconfig\"\r\nfi\r\n\r\necho\r\necho \"shutting the kernel down\"\r\necho o > /proc/sysrq-trigger\r\nsleep 10\r\n\u001b]133;D;0\u0007\u001b]133;A\u0007$ \u001b]133;B\u0007\u001b[K"]
[388.96934, "o", "./linux rootfstype=hostfs rootflags=/ ro init=/root/kxreplay/inside.sh mem=256M\r\n\u001b]133;C\u0007"]
[388.978021, "o", "Core dump limits :\r\n\tsoft - NONE\r\n\thard - NONE\r\nChecking environment variables for a tempdir...none found\r\nChecking if /dev/shm is on tmpfs...OK\r\nChecking PROT_EXEC mmap in /dev/shm...OK\r\nChecking that ptrace can change system call numbers..."]
[388.978291, "o", "OK\r\nChecking syscall emulation for ptrace..."]
[388.980748, "o", "OK\r\n"]
