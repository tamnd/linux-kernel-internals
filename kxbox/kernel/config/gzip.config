# Profile A-gzip: the same kernel, compressed with gzip rather than xz.
#
# xz gives a smaller file and a slower decompression. gzip gives a bigger file and a faster one.
# In a browser both of those are on the reader's critical path, and which one wins depends on
# their connection and their machine rather than on which number is nicer.
#
# So both get built and both get timed, and the answer goes in RESULTS.md next to the measurement
# that produced it.

CONFIG_KERNEL_GZIP=y
# CONFIG_KERNEL_XZ is not set
