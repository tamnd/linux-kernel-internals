# Profile D: the debugging kernel, for lesson C09.
#
# lockdep watches every lock the kernel takes and builds a graph of the order they were taken in,
# then complains the first time an ordering could deadlock, whether or not it did. That is the
# whole point of C09, and it costs enough that this is not the image a reader boots by default.
#
# KASAN is here for the same reason: the driver capstone is graded by the kernel's own debug
# options, and a reader has to be able to see them working before they trust them.

CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_LOCK_ALLOC=y
CONFIG_LOCKDEP=y
CONFIG_DEBUG_LOCKDEP=y
CONFIG_LOCK_STAT=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_SPINLOCK=y
CONFIG_DEBUG_MUTEXES=y
CONFIG_DEBUG_RWSEMS=y
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_DEBUG_KMEMLEAK=y
CONFIG_FAULT_INJECTION=y
CONFIG_FAILSLAB=y
