# Profile E: the memory checking kernel, which is the one the milestone called the kasan profile.
#
# It is not KASAN, and it cannot be. `arch/x86/Kconfig` on the pinned kernel says
#
#     select HAVE_ARCH_KASAN                  if X86_64
#     select HAVE_ARCH_KFENCE
#
# and Tier 0 is 32 bit x86, because v86 is a 32 bit emulator. `menuconfig KASAN` depends on
# HAVE_ARCH_KASAN, nothing selects that on i386, so CONFIG_KASAN is not a symbol that exists on
# this build. Setting it produces a `.config` without it and no error anywhere, which is exactly
# what happened to `config/lockdep.config` for as long as that file has existed. The excerpt of
# arch/x86/Kconfig in the corpus is where those two lines are kept, and `tools/kconfig` now reads
# the condition off it and fails a fragment that asks for a symbol the architecture cannot have.
#
# There is a second reason on top of the architecture, and it would apply on a 64 bit build too.
# KASAN also depends on `!SLUB_TINY`, and the Tier 0 base is tinyconfig, which sets SLUB_TINY.
#
# So this profile is built out of what a 32 bit kernel does have. KFENCE is the sampling cousin of
# KASAN: it catches a subset of the same bugs, out of band redzones on a rotating handful of
# allocations rather than a shadow byte for every eight bytes of memory, at a cost small enough to
# leave on. It is selected with no condition on it, so i386 gets it. The page and slab debuggers
# fill in most of the rest.

# The slab. SLUB_TINY has to go first, because SLUB_DEBUG depends on !SLUB_TINY and the base
# config turns SLUB_TINY on. Unsetting it costs image size, which is the trade this profile is.
# CONFIG_SLUB_TINY is not set
CONFIG_SLUB_DEBUG=y
CONFIG_SLUB_DEBUG_ON=y

# KFENCE. The sample interval is milliseconds between guarded allocations and the object count is
# how many can be guarded at once, and both defaults are the kernel's own. The kernel declares
# `range 1 65535` on the object count, which is the only place it says out loud what that number
# is allowed to be.
CONFIG_KFENCE=y
CONFIG_KFENCE_SAMPLE_INTERVAL=100
CONFIG_KFENCE_NUM_OBJECTS=255
# KFENCE_STATIC_KEYS is deliberately absent. It depends on JUMP_LABEL, and the Tier 0 base does
# not have JUMP_LABEL, so asking for it would be the same mistake this file exists to correct.

# Pages. DEBUG_PAGEALLOC unmaps a page after it is freed, so a use after free is a page fault with
# a stack trace rather than a value that is quietly wrong. The default flag is here because the
# reader is not going to type debug_pagealloc=on at a boot prompt they never see.
CONFIG_DEBUG_PAGEALLOC=y
CONFIG_DEBUG_PAGEALLOC_ENABLE_DEFAULT=y
CONFIG_PAGE_POISONING=y

# Objects and lists, which is where a corruption usually shows up first.
CONFIG_DEBUG_OBJECTS=y
CONFIG_DEBUG_OBJECTS_FREE=y
CONFIG_DEBUG_LIST=y
CONFIG_SCHED_STACK_END_CHECK=y
