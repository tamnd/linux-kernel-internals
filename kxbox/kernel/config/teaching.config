# The teaching config: everything the book needs the kernel to be able to tell you about itself.
#
# This is a Kconfig fragment, not a .config. It gets merged over a base defconfig by the kernel's
# own scripts/kconfig/merge_config.sh, which is the only thing that knows the dependencies between
# these symbols. A checked in full .config would be stale after one release and wrong in a way
# nobody could see.
#
# Every symbol here is here because a lesson or a checker stops working without it. If you are
# adding one, say which.

# Tracing. Z02 and every trace in the book.
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_STACK_TRACER=y
CONFIG_SCHED_TRACER=y
CONFIG_IRQSOFF_TRACER=y

# Dynamic probes, for the places ftrace cannot reach. kxprobe needs these.
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBES=y
CONFIG_UPROBE_EVENTS=y

# Names. Without KALLSYMS_ALL a trace is addresses, and half of what a beginner learns from a
# trace is that the names are readable.
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# Type information. This is what bpc generates blueprint sections 2 and 7 from, and it is the
# reason no field offset in this book can be stale.
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_PAHOLE_HAS_SPLIT_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y

# The filesystems the kernel describes itself through.
CONFIG_PROC_FS=y
CONFIG_PROC_KCORE=y
CONFIG_PROC_PAGE_MONITOR=y
CONFIG_SYSFS=y
CONFIG_DEBUG_FS=y

# Modules, because every part of the book ends in a change and most of those changes are a module.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
# Signing would mean a reader cannot load the module they just wrote.
# CONFIG_MODULE_SIG is not set

# BPF, for the lessons where a tracepoint is not enough.
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_EVENTS=y

# Storage, for the filesystem lessons and the filesystem capstone.
CONFIG_BLOCK=y
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FUSE_FS=y

# The scheduler lessons want to see the numbers, not infer them.
CONFIG_SCHED_DEBUG=y
CONFIG_SCHEDSTATS=y
CONFIG_TASK_DELAY_ACCT=y

# Memory. MGLRU and hugepages both appear in Part IV, and both change what /proc shows.
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_MEMCG=y
CONFIG_PAGE_OWNER=y
