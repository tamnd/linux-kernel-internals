# The shape of the machine v86 gives us.
#
# v86 is a 32-bit x86 emulator with one processor. Both of those are limitations rather than
# choices, they are stated in every lesson that touches concurrency, and they are the reason the
# SMP corpus and the formal memory model exist.
#
# None of this has been built yet. The line most likely to be wrong on the first attempt is the
# processor family, because it decides which instructions the compiler is allowed to emit and
# v86 does not implement all of them. Getting a boot failure here looks like an immediate reboot
# with no output, which is worth knowing before it happens to you.

# 32-bit x86. Not a preference.
# CONFIG_64BIT is not set
CONFIG_X86_32=y
CONFIG_M586TSC=y
# CONFIG_X86_PAE is not set
CONFIG_MATH_EMULATION=y

# One processor. This is the largest single limitation in the Tier 0 design.
# CONFIG_SMP is not set
CONFIG_PREEMPT=y
CONFIG_HZ_100=y
CONFIG_HIGH_RES_TIMERS=y

# The devices v86 emulates, and nothing else, because everything else is image size.
CONFIG_PCI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# The console. The bridge talks to the kernel over the serial port, so this is how a command gets
# in and how a trace comes out.
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=4

# Booting from an initramfs, because there is no disk to boot from.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Off, because the browser pays for every byte twice and none of these are taught here.
# CONFIG_SOUND is not set
# CONFIG_DRM is not set
# CONFIG_WIRELESS is not set
# CONFIG_BT is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_ACPI is not set
