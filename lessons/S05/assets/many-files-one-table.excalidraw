      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "text": "The table is shared and constant, so nothing about one file can live in it.",
      "originalText": "The table is shared and constant, so nothing about one file can live in it.",
      "fontSize": 14,
      "fontFamily": 1,
