      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "text": "Everything that differs between two open files is in the file, usually private_data.",
      "originalText": "Everything that differs between two open files is in the file, usually private_data.",
